# NutriTrack environment configuration (example).
# Copy to .env.local and adjust. Never commit real secrets.

# Optional: identifying User-Agent for Open Food Facts API requests,
# as recommended by their API documentation. Keep it descriptive and
# anonymous — no personal data, no secrets, no fake browser UAs.
# Defaults to "NutriTrack/0.1 (food lookup application; https://github.com/sergiotarini789-hub/NutriTrack)".
# OPEN_FOOD_FACTS_USER_AGENT="NutriTrack/0.1 (food lookup application)"

# Test/operations override for the Open Food Facts API base URL (the
# v3 product/barcode endpoint). Defaults to https://world.openfoodfacts.org.
# Used only to point the server-side proxy at a local stub in automated
# tests; not needed in normal development or production.
# OPEN_FOOD_FACTS_API_BASE="https://world.openfoodfacts.org"

# Test/operations override for the OFF text-search base URL
# (Search-a-licious). Defaults to https://search.openfoodfacts.org.
# When unset, OPEN_FOOD_FACTS_API_BASE applies (same override pattern);
# set this only when the search stub lives on a different host.
# OPEN_FOOD_FACTS_SEARCH_API_BASE="https://search.openfoodfacts.org"
